local function isWebhookURL(url)
    return type(url) == "string"
        and url:match("^https://discord%.com/api/webhooks/%d+/[%w%-_]+$") ~= nil
end

local function isSnowflake(id)
    if type(id) == "number" then return id > 0 and id < 1e19 end
    if type(id) == "string" then return id:match("^%d+$") ~= nil end
    return false
end

