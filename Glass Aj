-- [4] NOTIFIER — multi-target, non-blocking, pcall'd
-- =========================================================
local HttpService = game:GetService("HttpService")

local function buildMention()
    local ids = genv.TARGET_USER_IDS or {}
    if #ids == 0 then return "" end
    local parts = {}
    for _, id in ipairs(ids) do
        parts[#parts + 1] = "<@" .. id .. ">"
    end
    return table.concat(parts, " ")
end

local function notifyDiscord(message)
    if not genv.GOOD_WEBHOOK then return end
    local mention = buildMention()
    local content = mention ~= "" and (mention .. " " .. message) or message

    task.spawn(function()
        local payload = {
            username   = "AxomJB",
            avatar_url = genv.GOOD_AVATAR,
            content    = content,
            allowed_mentions = {
                parse = { "users" },
                users = genv.TARGET_USER_IDS,
            },
        }
        pcall(function()
            HttpService:PostAsync(
                genv.GOOD_WEBHOOK,
                HttpService:JSONEncode(payload),
                Enum.HttpContentType.ApplicationJson
            )
        end)
    end)
end

-- =========================================================
-- [5] SAFE FETCH + LOADSTRING
-- =========================================================
local function safeHttpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" and #res > 0 then return res end
    return nil
end

local function safeLoadString(src, label)
    if not src or #src == 0 then return false end
    local fn, err = loadstring(src, "=" .. label)
    if not fn then
        warn(("[AxomJB] loadstring fail on %s: %s"):format(label, tostring(err)))
        return false
    end
    local ok, runErr = pcall(fn)
    if not ok then
        warn(("[AxomJB] runtime fail on %s: %s"):format(label, tostring(runErr)))
        return false
    end
    return true
end

